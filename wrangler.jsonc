// The catalog browser and catalog.json at https://aquatic.dev/catalog/, as a
// worker of static assets alone. The Build Site action assembles site, with
// the files under site/catalog, as the routes serve them; a request for
// /catalog redirects to /catalog/, where the page's relative fetch of
// catalog.json resolves.
{
  "name": "catalog",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "aquatic.dev/catalog", "zone_name": "aquatic.dev" },
    { "pattern": "aquatic.dev/catalog/*", "zone_name": "aquatic.dev" }
  ]
}
