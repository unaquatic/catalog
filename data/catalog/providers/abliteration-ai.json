      "capabilities": {
        "tools": true,
        "attachments": false,
        "structured_output": true,
        "temperature": true,
        "input": [
          "text"
        ],
        "output": [
          "text"
        ]
      },
      "limit": {
        "context": 1000000,
        "input": 1000000,
        "output": 999990
      },
      "reasoning": {
        "mandatory": false,
        "efforts": [
          "none",
          "high",
          "max"
        ]
      },
      "provider_options": {
        "id": "abliterated-model-large",
        "name": "Abliterated Model Large"
      },
      "price": {
        "input": 5,
        "output": 5,
        "cache_read": 0.5
      }
    },
    "abliteration-ai/abliterated-model-large-v2": {
